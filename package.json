{
  "name": "vera-message-engine",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "benchmark": "node --import tsx scripts/run_benchmark.ts",
    "adversarial": "node --import tsx --test tests/adversarial.test.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/decision.test.ts",
    "test:api": "node --import tsx --test tests/api.test.ts",
    "submission": "node --import tsx scripts/generate_submission.ts",
    "verify": "npm run lint && npm run build && npm test && npm run benchmark",
    "test:runtime": "python scripts/verify_runtime.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
