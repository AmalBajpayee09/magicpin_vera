# Core requires no API key. Copy to .env, then set your real submission identity.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
TEAM_NAME=VERA Candidate
TEAM_MEMBERS=Candidate
CONTACT_EMAIL=candidate@example.com
SUBMITTED_AT=2026-11-16T00:00:00Z
STATE_FILE=./data/state.json
# Keep both false for judging. Fixture preload and state inspection are local demo features.
PRELOAD_DATASET=false
ENABLE_DASHBOARD=false
# Optional: only set if the judge can supply Authorization: Bearer <value>.
BOT_TOKEN=
# Used ONLY by scripts/run_official_judge.py. Keep blank for local warmup.
BOT_URL=http://127.0.0.1:8080
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
